{
  "about": "Shared contract for the AthleteBridge iOS and Android apps, which share one Firestore database. Identical copies live in both repos under cross-platform/ (check.sh keeps them in sync). Each app records what its real code writes for every story below (fixtures/<platform>/<story>.json); the other app's tests then read and act on those documents. See README.md.",
  "version": 1,

  "actors": {
    "coach":   { "role": "COACH",  "first": "Mei",  "last": "Chen" },
    "coach2":  { "role": "COACH",  "first": "Raj",  "last": "Patel" },
    "client":  { "role": "CLIENT", "first": "Alex", "last": "Kim" },
    "client2": { "role": "CLIENT", "first": "Sam",  "last": "Lee" }
