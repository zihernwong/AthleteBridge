rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Web Tournament Manager — public read/write (internal tool, no login required)
    match /webTournaments/{id} {
      allow read, write: if true;
    }

    // Web Series/Seasons — public read/write
    match /webSeries/{id} {
      allow read, write: if true;
    }

    // Web Player Profiles — public read; any auth'd user can create/update; only owner can delete
    match /webPlayers/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // All other collections: authenticated users only.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
