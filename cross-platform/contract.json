  "statuses": {
    "about": "Booking statuses either app may write. A status outside this list is one the other app has never been taught to show.",
    "known": ["requested", "Pending Acceptance", "pending_payment", "payment_submitted", "partially_accepted", "partially_confirmed", "confirmed", "fully_confirmed", "cancelled", "rejected", "declined_by_client"]
  },

  "cloudFunction": {
    "about": "pendingNotifications/{uid}/notifications docs become pushes through onPendingNotificationCreate (AthleteBridge/functions/src/index.ts), which copies only these keys into the FCM data payload and adds recipientUid. Anything else in the doc never reaches the phone.",
    "forwardedKeys": ["chatId", "messageId", "bookingId", "type", "stringerOrderId", "placeId", "announcementId", "eventId", "tournamentId"],
    "addedKeys": ["recipientUid"],
    "chatMessagePushes": "onMessageCreate pushes every new chats/{chatId}/messages doc itself (type chat, chatId, messageId), so an app that also queues a pendingNotifications push for a message notifies the recipient twice."
  },

  "pushRouting": {
    "about": "What tapping each push type must open, given the data a phone actually receives (after the Cloud Function). Screens: booking, bookings, payments, chat, stringerOrder, club, myClubs, clubAnnouncements, signupEvent, signupEvents, tournaments. Where the apps legitimately differ, accept lists every acceptable screen.",
    "routes": [
      { "type": "booking_request",       "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "booking_accepted",      "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "booking_rejected",      "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "booking_confirmed",     "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "booking_rescheduled",   "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "booking_declined",      "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "booking_cancelled",     "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }, { "screen": "bookings" }] },
      { "type": "payment_submitted",     "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "payment_acknowledged",  "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "booking", "id": "{{booking}}" }] },
      { "type": "payment_confirmed",     "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "payments" }] },
      { "type": "payment_reminder",      "data": { "bookingId": "{{booking}}" }, "accept": [{ "screen": "payments" }] },
      { "type": "chat",                  "data": { "chatId": "{{chat}}", "messageId": "{{message}}" }, "accept": [{ "screen": "chat", "id": "{{chat}}" }] },
      { "type": "stringer_order",        "data": { "stringerOrderId": "{{order}}" }, "accept": [{ "screen": "stringerOrder", "id": "{{order}}" }] },
      { "type": "club_join_request",     "data": { "placeId": "{{club}}" }, "accept": [{ "screen": "club", "id": "{{club}}" }] },
      { "type": "club_approved",         "data": { "placeId": "{{club}}" }, "accept": [{ "screen": "club", "id": "{{club}}" }, { "screen": "myClubs" }] },
      { "type": "club_announcement",     "data": { "placeId": "{{club}}", "announcementId": "{{announcement}}" }, "accept": [{ "screen": "clubAnnouncements", "id": "{{club}}" }] },
      { "type": "event_waitlist_promoted", "data": { "placeId": "{{club}}", "eventId": "{{event}}" }, "accept": [{ "screen": "signupEvent", "id": "{{event}}" }] },
      { "type": "tournament_partner",    "data": { "tournamentId": "{{tournament}}" }, "accept": [{ "screen": "tournaments" }] },
      { "type": "tournament_recommendation", "data": { "tournamentId": "{{tournament}}" }, "accept": [{ "screen": "tournaments" }] }
    ]
  },

